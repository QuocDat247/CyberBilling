<Window x:Class="CyberBilling.Client.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberBilling - Máy trạm"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1F2937">

    <Grid>

        <Image x:Name="WallpaperImage"
               Stretch="UniformToFill"/>

        <!-- Lớp tối nhẹ để chữ dễ đọc -->
        <Border Background="#55000000"/>

        <Grid Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock x:Name="ClockText"
                           Text="--:--"
                           Foreground="White"
                           FontSize="76"
                           FontWeight="Light"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="DateText"
                           Margin="0,4,0,36"
                           Foreground="White"
                           FontSize="22"
                           HorizontalAlignment="Center"/>

                <Border Background="#CCFFFFFF"
                        CornerRadius="14"
                        Padding="36,26">

                    <StackPanel>

                        <TextBlock Text="CYBERBILLING - MÁY TRẠM"
                                   Foreground="#1F2937"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Máy trạm đang khóa"
                                   Margin="0,12,0,0"
                                   Foreground="#2563EB"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Liên hệ quầy tính tiền để bắt đầu sử dụng"
                                   Margin="0,8,0,0"
                                   Foreground="#667085"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>

                        <Grid Margin="0,24,0,0"
                              Width="330">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Tài khoản quản trị"
                                       Foreground="#344054"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="AdminUsernameTextBox"
                                     Grid.Row="2"
                                     Height="40"
                                     Padding="9,6"
                                     FontSize="15"
                                     Text="admin"/>

                            <TextBlock Grid.Row="4"
                                       Text="Mật khẩu"
                                       Foreground="#344054"
                                       FontWeight="SemiBold"/>

                            <PasswordBox x:Name="AdminPasswordBox"
                                         Grid.Row="6"
                                         Height="40"
                                         Padding="9,6"
                                         FontSize="15"/>

                            <Button x:Name="AdminLoginButton"
                                    Grid.Row="8"
                                    Height="42"
                                    Content="Đăng nhập quản trị"
                                    FontWeight="SemiBold"
                                    Click="AdminLoginButton_Click"/>

                        </Grid>

                        <TextBlock x:Name="AdminLoginMessageText"
                                   Margin="0,12,0,0"
                                   Foreground="#B42318"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        
                        <TextBlock x:Name="ConnectionText"
                                   Text="Đang kết nối với máy tính tiền..."
                                   Margin="0,18,0,0"
                                   Foreground="#667085"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</Window>