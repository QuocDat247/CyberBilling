<Window x:Class="CyberBilling.Server.Dialogs.AdminLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập quyền quản trị"
        Width="416"
        Height="271"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F7">

    <Grid Margin="26">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ĐĂNG NHẬP QUYỀN QUẢN TRỊ"
                   Foreground="#1F2937"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="2">

            <TextBlock Text="Mật khẩu quản trị"
                       Foreground="#344054"
                       FontWeight="SemiBold"/>

            <PasswordBox x:Name="PasswordBox"
                         Height="40"
                         Margin="0,7,0,0"
                         Padding="8,5"/>

        </StackPanel>

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Height="40"
                    Content="Đăng nhập"
                    Click="LoginButton_Click"/>

            <Button Grid.Column="2"
                    Height="40"
                    Content="Hủy"
                    Click="CancelButton_Click"/>

        </Grid>

    </Grid>

</Window>