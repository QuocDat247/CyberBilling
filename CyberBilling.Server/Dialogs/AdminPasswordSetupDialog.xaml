<Window x:Class="CyberBilling.Server.Dialogs.AdminPasswordSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập mật khẩu quản trị"
        Width="420"
        Height="370"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F7">

    <Grid Margin="26">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="MẬT KHẨU QUẢN TRỊ"
                       Foreground="#1F2937"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Mật khẩu này dùng để mở khóa máy trạm với quyền quản trị."
                       Margin="0,7,0,0"
                       TextWrapping="Wrap"
                       Foreground="#667085"/>

        </StackPanel>

        <StackPanel Grid.Row="2">

            <TextBlock Text="Mật khẩu"
                       Foreground="#344054"
                       FontWeight="SemiBold"/>

            <PasswordBox x:Name="PasswordBox"
                         Height="38"
                         Margin="0,7,0,0"
                         Padding="8,5"/>

        </StackPanel>

        <StackPanel Grid.Row="4">

            <TextBlock Text="Nhập lại mật khẩu"
                       Foreground="#344054"
                       FontWeight="SemiBold"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="38"
                         Margin="0,7,0,0"
                         Padding="8,5"/>

        </StackPanel>

        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Height="40"
                    Content="Lưu"
                    Click="SaveButton_Click"/>

            <Button Grid.Column="2"
                    Height="40"
                    Content="Hủy"
                    Click="CancelButton_Click"/>

        </Grid>

    </Grid>

</Window>