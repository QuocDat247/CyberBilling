<Window x:Class="CyberBilling.Server.Dialogs.SessionServiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dịch vụ máy trạm"
        Width="1050"
        Height="650"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F7">

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="DỊCH VỤ MÁY TRẠM"
                       Foreground="#1F2937"
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="MachineText"
                       Margin="0,5,0,0"
                       Foreground="#2563EB"
                       FontSize="16"
                       FontWeight="SemiBold"/>

        </StackPanel>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- ĐÃ CHỌN -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Dịch vụ đã chọn"
                               Foreground="#1F2937"
                               FontSize="17"
                               FontWeight="SemiBold"/>

                    <DataGrid x:Name="SelectedServicesGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              Background="White"
                              Foreground="#1F2937"
                              BorderBrush="#D8DEE8"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Dịch vụ"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Đơn giá"
                                                Binding="{Binding PriceText}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Số lượng"
                                                Binding="{Binding Quantity}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Thành tiền"
                                                Binding="{Binding TotalText}"
                                                Width="110"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal">

                        <Button Width="70"
                                Height="36"
                                Content="+ 1"
                                Click="IncreaseButton_Click"/>

                        <Button Width="70"
                                Height="36"
                                Margin="8,0,0,0"
                                Content="- 1"
                                Click="DecreaseButton_Click"/>

                        <Button Width="80"
                                Height="36"
                                Margin="8,0,0,0"
                                Content="Xóa"
                                Click="RemoveButton_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- DANH MỤC -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Danh mục dịch vụ"
                               Foreground="#1F2937"
                               FontSize="17"
                               FontWeight="SemiBold"/>

                    <TabControl x:Name="CategoryTabs"
                                Grid.Row="2"
                                Height="36"
                                Background="Transparent"
                                BorderThickness="0"
                                SelectionChanged="CategoryTabs_SelectionChanged">

                        <TabItem Header="Tất cả"
                                 Tag="*"/>

                        <TabItem Header="Thức ăn"
                                 Tag="Thức ăn"/>

                        <TabItem Header="Thức uống"
                                 Tag="Thức uống"/>

                        <TabItem Header="Thuốc lá"
                                 Tag="Thuốc lá"/>

                    </TabControl>

                    <DataGrid x:Name="CatalogGrid"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              Background="White"
                              Foreground="#1F2937"
                              BorderBrush="#D8DEE8"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              SelectionMode="Single"
                              MouseDoubleClick="CatalogGrid_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Dịch vụ"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Đơn vị"
                                                Binding="{Binding Unit}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Giá bán"
                                                Binding="{Binding PriceText}"
                                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <Button Grid.Row="6"
                            Width="100"
                            Height="36"
                            HorizontalAlignment="Right"
                            Content="Thêm"
                            Click="AddButton_Click"/>

                </Grid>

            </Border>

        </Grid>

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Tổng dịch vụ:"
                           Foreground="#344054"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="TotalText"
                           Margin="10,0,0,0"
                           Text="0 đ"
                           Foreground="#2563EB"
                           FontSize="21"
                           FontWeight="Bold"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Width="100"
                        Height="40"
                        Content="Đồng ý"
                        Click="AcceptButton_Click"/>

                <Button Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Content="Hủy"
                        Click="CancelButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>