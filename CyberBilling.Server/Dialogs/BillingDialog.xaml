<Window x:Class="CyberBilling.Server.Dialogs.BillingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tính tiền"
        Width="500"
        Height="690"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101827">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="24">

            <TextBlock Text="TÍNH TIỀN"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="MachineNameText"
                       Margin="0,5,0,20"
                       Foreground="#7FB0FF"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            <!-- MÁY HIỆN TẠI -->

            <Border Background="#162033"
                    BorderBrush="#2B3A52"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <StackPanel>

                    <TextBlock Text="Sử dụng"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,0,0,12"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Thời gian:"
                                   Foreground="#9FB3CE"/>

                        <TextBlock x:Name="UsedTimeText"
                                   Grid.Column="1"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1"
                                   Text="Thời gian phí:"
                                   Foreground="#9FB3CE"/>

                        <TextBlock x:Name="UsageAmountText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2"
                                   Text="Dịch vụ phí:"
                                   Foreground="#9FB3CE"/>

                        <TextBlock x:Name="ServiceAmountText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- THANH TOÁN KÈM -->

            <Border Margin="0,14,0,0"
                    Background="#162033"
                    BorderBrush="#2B3A52"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <StackPanel>

                    <TextBlock Text="Thanh toán thêm cho máy khác"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="LinkedMachineComboBox"
                              Margin="0,12,0,14"
                              Height="36"
                              SelectionChanged="LinkedMachineComboBox_SelectionChanged"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Thời gian phí:"
                                   Foreground="#9FB3CE"/>

                        <TextBlock x:Name="LinkedUsageAmountText"
                                   Grid.Column="1"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1"
                                   Text="Dịch vụ phí:"
                                   Foreground="#9FB3CE"/>

                        <TextBlock x:Name="LinkedServiceAmountText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- TỔNG -->

            <Border Margin="0,14,0,0"
                    Background="#162033"
                    BorderBrush="#2B3A52"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <StackPanel>

                    <TextBlock Text="Tổng cộng"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Grid Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Số tiền máy tính:"
                                   Foreground="#9FB3CE"/>

                        <TextBlock x:Name="CalculatedAmountText"
                                   Grid.Column="1"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1"
                                   Text="Số tiền thực thu:"
                                   Foreground="#9FB3CE"/>

                        <TextBlock x:Name="PayableAmountText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Foreground="#7BE3A8"
                                   FontWeight="Bold"
                                   FontSize="18"/>

                    </Grid>

                    <TextBlock x:Name="LargePayableAmountText"
                               Margin="0,15,0,0"
                               TextAlignment="Center"
                               Foreground="#75A7FF"
                               FontSize="42"
                               FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

            <Grid Margin="0,18,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="44"
                        Content="Thanh toán"
                        Click="PayButton_Click"/>

                <Button Grid.Column="2"
                        Height="44"
                        Content="Thanh toán + Tắt máy"
                        Click="PayAndShutdownButton_Click"/>

                <Button Grid.Column="4"
                        Height="44"
                        Content="Hủy"
                        Click="CancelButton_Click"/>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</Window>