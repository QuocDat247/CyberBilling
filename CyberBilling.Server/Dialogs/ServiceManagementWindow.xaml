<Window x:Class="CyberBilling.Server.Dialogs.ServiceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý dịch vụ"
        Width="900"
        Height="600"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F7">

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="QUẢN LÝ DỊCH VỤ"
                       Foreground="#1F2937"
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Danh mục thức ăn, thức uống và thuốc lá"
                       Margin="0,5,0,0"
                       Foreground="#667085"/>

        </StackPanel>

        <TabControl x:Name="CategoryTabs"
                    Grid.Row="2"
                    Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="CategoryTabs_SelectionChanged">

            <TabItem Header="Tất cả"
                     Tag="*"/>

            <TabItem Header="Thức ăn"
                     Tag="Thức ăn"/>

            <TabItem Header="Thức uống"
                     Tag="Thức uống"/>

            <TabItem Header="Thuốc lá"
                     Tag="Thuốc lá"/>

        </TabControl>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">

            <DataGrid x:Name="ServicesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5E7EB"
                      Background="White"
                      Foreground="#1F2937"
                      BorderThickness="0"
                      SelectionMode="Single"
                      RowHeight="42"
                      ColumnHeaderHeight="40">

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="#F8FAFC"/>
                        <Setter Property="Foreground"
                                Value="#344054"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Padding"
                                Value="10,0"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background"
                                Value="White"/>
                        <Setter Property="Foreground"
                                Value="#1F2937"/>

                        <Style.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#DCEAFF"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="10,0"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Tên dịch vụ"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Nhóm"
                                        Binding="{Binding Category}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Đơn vị"
                                        Binding="{Binding Unit}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Giá bán"
                                        Binding="{Binding PriceText}"
                                        Width="150"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Width="90"
                    Height="38"
                    Content="Thêm"
                    Click="AddButton_Click"/>

            <Button Width="90"
                    Height="38"
                    Margin="10,0,0,0"
                    Content="Sửa"
                    Click="EditButton_Click"/>

            <Button Width="90"
                    Height="38"
                    Margin="10,0,0,0"
                    Content="Xóa"
                    Click="DeleteButton_Click"/>

            <Button Width="90"
                    Height="38"
                    Margin="10,0,0,0"
                    Content="Đóng"
                    Click="CloseButton_Click"/>

        </StackPanel>

    </Grid>

</Window>