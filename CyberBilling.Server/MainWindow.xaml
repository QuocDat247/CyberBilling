<Window x:Class="CyberBilling.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberBilling Server"
        Height="650"
        Width="1250"
        MinHeight="520"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#101827">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Padding="18"
                Background="#162033"
                BorderBrush="#2B3A52"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="CyberBilling Server"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ServerStatusText"
                               Margin="0,7,0,0"
                               Text="Đang khởi động..."
                               Foreground="#9FB3CE"
                               FontSize="14"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="Giá giờ:"
                               Foreground="#9FB3CE"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBox x:Name="HourlyRateTextBox"
                             Width="85"
                             Height="34"
                             Padding="8,5"
                             Text="6000"
                             TextChanged="MoneyTextBox_TextChanged"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="đ"
                               Foreground="#9FB3CE"
                               VerticalAlignment="Center"
                               Margin="6,0,14,0"/>

                    <TextBlock Text="Tối thiểu:"
                               Foreground="#9FB3CE"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBox x:Name="MinimumChargeTextBox"
                             Width="85"
                             Height="34"
                             Padding="8,5"
                             Text="1000"
                             TextChanged="MoneyTextBox_TextChanged"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="đ"
                               Foreground="#9FB3CE"
                               VerticalAlignment="Center"
                               Margin="6,0,12,0"/>

                    <Button x:Name="ApplyHourlyRateButton"
                            Width="80"
                            Height="34"
                            Content="Áp dụng"
                            Click="ApplyHourlyRateButton_Click"/>

                    <Button Width="90"
                            Height="34"
                            Margin="10,0,0,0"
                            Content="Lịch sử"
                            Click="PaymentHistoryButton_Click"/>

                </StackPanel>

                <Border Grid.Column="3"
                        VerticalAlignment="Center"
                        Background="#173E2B"
                        Padding="12,7"
                        CornerRadius="6">

                    <TextBlock x:Name="ListeningText"
                               Text="PORT 5055"
                               Foreground="#7BE3A8"
                               FontWeight="SemiBold"/>

                </Border>

            </Grid>

        </Border>

        <!-- WORKSTATION GRID -->
        <Border Grid.Row="2"
                Background="#162033"
                BorderBrush="#2B3A52"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

            <DataGrid x:Name="WorkstationsGrid"
                      PreviewMouseRightButtonDown="WorkstationsGrid_PreviewMouseRightButtonDown"
                      MouseDoubleClick="WorkstationsGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2B3A52"
                      RowHeight="46"
                      ColumnHeaderHeight="40"
                      Background="#162033"
                      Foreground="White"
                      BorderThickness="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.ContextMenu>

                    <ContextMenu Opened="WorkstationContextMenu_Opened">

                        <MenuItem x:Name="StartPrepaidMenuItem"
                                  Header="Đăng nhập (trả tiền trước)"
                                  Click="StartPrepaidMenuItem_Click"/>

                        <MenuItem x:Name="PayPrepaidMenuItem"
                                  Header="Thanh toán"
                                  Click="PayPrepaidMenuItem_Click"/>

                        <MenuItem x:Name="BillPostpaidMenuItem"
                                  Header="Tính tiền"
                                  Click="BillPostpaidMenuItem_Click"/>

                    </ContextMenu>

                </DataGrid.ContextMenu>

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#1D2A40"/>

                        <Setter Property="Foreground"
                                Value="#DCE7F7"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="BorderBrush"
                                Value="#2B3A52"/>

                        <Setter Property="BorderThickness"
                                Value="0,0,1,1"/>

                        <Setter Property="Padding"
                                Value="10,0"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                    </Style>

                    <Style TargetType="DataGridRow">

                        <Setter Property="Background"
                                Value="#162033"/>

                        <Setter Property="Foreground"
                                Value="#E8EEF8"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#1D2A40"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#254A78"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                    <Style TargetType="DataGridCell">

                        <Setter Property="Background"
                                Value="Transparent"/>

                        <Setter Property="Foreground"
                                Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                Path=Foreground}"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Setter Property="Padding"
                                Value="10,0"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>

                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Máy trạm"
                                        Binding="{Binding WorkstationNumberText}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Tình trạng"
                                        Binding="{Binding Status}"
                                        Width="140"/>

                    <!--
                        Chỉ ô TÊN MÁY được phép đổi màu.
                    -->
                    <DataGridTemplateColumn Header="Tên máy"
                                            Width="180">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Background="{Binding MachineNameBackground}"
                                        CornerRadius="4"
                                        Margin="4"
                                        Padding="8,4">

                                    <TextBlock Text="{Binding MachineName}"
                                               Foreground="{Binding MachineNameForeground}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Bắt đầu"
                                        Binding="{Binding StartTimeText}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Đã dùng"
                                        Binding="{Binding UsedTimeText}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Còn lại"
                                        Binding="{Binding RemainingTimeText}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Số tiền"
                                        Binding="{Binding AmountText}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Ngày bắt đầu"
                                        Binding="{Binding StartDateText}"
                                        Width="150"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>